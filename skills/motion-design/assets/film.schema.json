{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design House optional film manifest v1",
  "$comment": "This schema validates field shapes. compile_timeline.py additionally enforces identifier uniqueness, reference resolution/cycles, scene and cue bounds, last-scene rules, overlap limits and non-collapsing frame windows after speed/quantization. JSON must not contain duplicate keys or non-finite numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fps", "size", "scenes"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "fps": {"type": "integer", "minimum": 1},
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration"],
      "properties": {
        "type": {"enum": ["cut", "overlap"]},
        "duration": {"type": "number", "minimum": 0}
      },
      "oneOf": [
        {"properties": {"type": {"const": "cut"}, "duration": {"const": 0}}},
        {"properties": {"type": {"const": "overlap"}, "duration": {"exclusiveMinimum": 0}}}
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "t": {"type": "number", "minimum": 0},
        "ref": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*\\.[a-zA-Z][a-zA-Z0-9_-]*$"},
        "offset": {"type": "number", "minimum": 0},
        "d": {"type": "number", "exclusiveMinimum": 0},
        "text": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}
      },
      "oneOf": [
        {"required": ["t"], "not": {"anyOf": [{"required": ["ref"]}, {"required": ["offset"]}]}},
        {"required": ["ref"], "not": {"required": ["t"]}}
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hold"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "hold": {"type": "number", "exclusiveMinimum": 0},
        "transition": {"$ref": "#/$defs/transition"},
        "cues": {"type": "array", "items": {"$ref": "#/$defs/cue"}}
      }
    }
  }
}
